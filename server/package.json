{
  "name": "northwind-digital-backend",
  "version": "1.0.0",
  "description": "Backend for the Northwind Digital site: contact form + content API",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node tests/run.js",
    "serve:static": "node tests/static-server.js 4173",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1"
  },
  "optionalDependencies": {
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "sharp": "^0.34.4"
  },
  "engines": {
    "node": ">=22.5"
  }
}