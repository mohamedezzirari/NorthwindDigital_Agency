# Copy to .env and fill in as needed. The server works with none of these set.

# Port and host for the Node server.
PORT=3000
HOST=127.0.0.1

# Where the SQLite file lives (defaults to server/data).
# DATA_DIR=./data

# --- Optional: one-off asset prep (not used by the running server) ---
# Key for scripts/brand-background.js, which cuts team photos out of their
# background and composites them onto the site's brand navy.
# Free key (50 low-res calls/month): https://www.remove.bg/api
# REMOVE_BG_API_KEY=

# --- Optional: email notifications for new leads ---
# Without these, new leads are logged to the server console instead.
# Install the optional dependency first:  npm install nodemailer
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-password-or-app-password
# SMTP_FROM=Website <you@example.com>
# NOTIFY_EMAIL=inbox@example.com